      </div>

      <div class="col-lg-6">
        <div class="glass p-4">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <span class="pill"><span class="pill-dot"></span> Transfer: London → Lagos</span>
            <span class="mono small" style="color:var(--ink-3)" id="swiftClock">—</span>
          </div>


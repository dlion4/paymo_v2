<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Paymo BAAS · Global Transfers &amp; Remittance — From Lagos to London. From Nairobi to New York. In Seconds.</title>
<meta name="description" content="SWIFT-alternative global transfers and remittance infrastructure. From Lagos to London, from Nairobi to New York. Send money across Africa and the world in seconds." />

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Geist:wght@400;600;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />

<style>
  /* ============ MASTER PAYMO CSS ============ */
  :root {
    --bg-0: #04081a; --bg-1: #06122e; --bg-2: #0a1a3f;
    --ink-0: #ffffff; --ink-1: #e6ecff; --ink-2: #a8b6e0; --ink-3: #6f82b5;
    --accent: #22d3ee; --accent-2: #60a5fa; --accent-3: #a78bfa; --accent-4: #fbbf24;
    --success: #22c55e; --danger: #ef4444;
    --glass-bg: rgba(255,255,255,0.04); --glass-border: rgba(255,255,255,0.10);
    --glass-strong: rgba(255,255,255,0.08); --glass-border-strong: rgba(255,255,255,0.16);
    --radius-lg: 22px; --radius-md: 14px; --radius-sm: 10px;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { font-family: 'Inter', system-ui, sans-serif; background: var(--bg-0); color: var(--ink-1); overflow-x: hidden; line-height: 1.55; -webkit-font-smoothing: antialiased; }
  h1,h2,h3,h4,h5 { font-family: 'Inter','Geist',sans-serif; font-weight: 800; letter-spacing: -0.02em; color: var(--ink-0); }
  code, pre, .mono { font-family: 'JetBrains Mono', monospace; }
  a { color: var(--accent); text-decoration: none; transition: color .2s; }
  a:hover { color: var(--accent-2); }

  .bg-gradient-deep {
    background:
      radial-gradient(1200px 600px at 80% -10%, rgba(96,165,250,0.22), transparent 60%),
      radial-gradient(900px 500px at -10% 20%, rgba(167,139,250,0.18), transparent 60%),
      radial-gradient(800px 500px at 50% 110%, rgba(34,211,238,0.18), transparent 60%),
      linear-gradient(180deg, #04081a 0%, #06122e 30%, #081838 70%, #04081a 100%);
  }
  .grid-overlay { background-image: linear-gradient(rgba(96,165,250,0.06) 1px, transparent 1px), linear-gradient(90deg, rgba(96,165,250,0.06) 1px, transparent 1px); background-size: 56px 56px; mask-image: radial-gradient(ellipse at center, black 40%, transparent 80%); }
  .blob { position: absolute; border-radius: 50%; filter: blur(80px); opacity: .45; pointer-events: none; animation: float 14s ease-in-out infinite; }
  @keyframes float { 0%,100% { transform: translate(0,0) scale(1); } 50% { transform: translate(40px,-30px) scale(1.08); } }
  @keyframes pulseGlow { 0%,100% { box-shadow: 0 0 0 0 rgba(34,211,238,0.35); } 50% { box-shadow: 0 0 0 14px rgba(34,211,238,0); } }
  .reveal { opacity: 0; transform: translateY(24px); transition: opacity .8s ease, transform .8s ease; }
  .reveal.in { opacity: 1; transform: translateY(0); }

  .glass { background: var(--glass-bg); border: 1px solid var(--glass-border); border-radius: var(--radius-lg); backdrop-filter: blur(20px) saturate(140%); -webkit-backdrop-filter: blur(20px) saturate(140%); box-shadow: 0 1px 0 0 rgba(255,255,255,0.04) inset, 0 30px 60px -30px rgba(0,0,0,0.5); }
  .glass-strong { background: var(--glass-strong); border: 1px solid var(--glass-border-strong); border-radius: var(--radius-lg); backdrop-filter: blur(24px) saturate(150%); -webkit-backdrop-filter: blur(24px) saturate(150%); }
  .glass-hover { transition: transform .35s ease, border-color .35s ease, background .35s ease; }
  .glass-hover:hover { transform: translateY(-4px); border-color: rgba(96,165,250,0.35); background: rgba(96,165,250,0.06); }

  .text-gradient { background: linear-gradient(135deg, #22d3ee 0%, #60a5fa 50%, #a78bfa 100%); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .text-gradient-gold { background: linear-gradient(135deg, #fde68a 0%, #fbbf24 100%); -webkit-background-clip: text; background-clip: text; color: transparent; }

  .btn { font-weight: 600; border-radius: 12px; padding: .75rem 1.4rem; transition: all .25s ease; letter-spacing: -0.01em; }
  .btn-primary-paymo { background: linear-gradient(135deg, #22d3ee 0%, #3b82f6 100%); color: #02121f; border: none; box-shadow: 0 10px 30px -10px rgba(34,211,238,0.55); }
  .btn-primary-paymo:hover { transform: translateY(-2px); color: #02121f; box-shadow: 0 14px 40px -10px rgba(34,211,238,0.75); }
  .btn-outline-paymo { background: transparent; color: var(--ink-1); border: 1px solid rgba(255,255,255,0.18); }
  .btn-outline-paymo:hover { background: rgba(255,255,255,0.08); border-color: var(--accent); color: var(--ink-0); }
  .btn-gold { background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%); color: #1f1200; border: none; box-shadow: 0 10px 30px -10px rgba(251,191,36,0.5); }
  .btn-gold:hover { transform: translateY(-2px); color: #1f1200; }

  .nav-glass { background: rgba(4,8,26,0.72); backdrop-filter: blur(18px) saturate(150%); -webkit-backdrop-filter: blur(18px) saturate(150%); border-bottom: 1px solid rgba(255,255,255,0.06); }
  .nav-link-paymo { color: var(--ink-2); font-weight: 500; font-size: .92rem; padding: .5rem .9rem; border-radius: 10px; transition: all .2s; }
  .nav-link-paymo:hover, .nav-link-paymo.active { color: var(--ink-0); background: rgba(255,255,255,0.05); }
  .logo-mark { width: 36px; height: 36px; border-radius: 10px; background: linear-gradient(135deg, #22d3ee, #60a5fa, #a78bfa); display: inline-flex; align-items: center; justify-content: center; color: #02121f; font-weight: 900; box-shadow: 0 8px 24px -8px rgba(34,211,238,.6); }

  .pill { display: inline-flex; align-items: center; gap: .5rem; padding: .35rem .85rem; border-radius: 999px; background: rgba(34,211,238,0.08); border: 1px solid rgba(34,211,238,0.25); font-size: .8rem; font-weight: 500; color: #a5f3fc; }
  .pill-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 10px var(--accent); animation: pulseGlow 2s infinite; }

  section { position: relative; padding: 5rem 0; }
  .kicker { display: inline-block; font-size: .78rem; font-weight: 600; text-transform: uppercase; letter-spacing: .18em; color: var(--accent); margin-bottom: 1rem; }

  .badge-mini { font-size: .7rem; padding: .2rem .55rem; border-radius: 999px; font-weight: 600; letter-spacing: .02em; }
  .badge-ok { background: rgba(34,197,94,0.15); color: #86efac; border: 1px solid rgba(34,197,94,0.3); }
  .badge-adv { background: rgba(167,139,250,0.15); color: #c4b5fd; border: 1px solid rgba(167,139,250,0.3); }
  .badge-native { background: rgba(34,211,238,0.15); color: #a5f3fc; border: 1px solid rgba(34,211,238,0.3); }
  .badge-partial { background: rgba(251,191,36,0.12); color: #fde68a; border: 1px solid rgba(251,191,36,0.25); }
  .badge-danger { background: rgba(239,68,68,0.12); color: #fca5a5; border: 1px solid rgba(239,68,68,0.25); }
  .chip { display: inline-flex; align-items: center; gap: .35rem; padding: .25rem .7rem; border-radius: 999px; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); font-size: .78rem; color: var(--ink-2); font-weight: 500; margin: .15rem; }
  .chip i { font-size: .8rem; color: var(--accent); }

  .mobile-nav-panel { position: fixed; inset: 0; background: rgba(4,8,26,0.96); backdrop-filter: blur(20px); z-index: 1040; display: none; padding: 6rem 2rem 2rem; }
  .mobile-nav-panel.show { display: block; animation: slideIn .3s ease; }
  .mobile-nav-panel a { color: var(--ink-1); padding: 1rem 0; border-bottom: 1px solid rgba(255,255,255,0.06); font-size: 1.2rem; display: block; }
  @keyframes slideIn { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: translateY(0); } }

  .modal-content.glass-strong { background: rgba(6,18,46,0.95); border: 1px solid rgba(255,255,255,0.1); color: var(--ink-1); border-radius: var(--radius-lg); }
  .modal-header { border-bottom-color: rgba(255,255,255,0.08) !important; }
  .newsletter-input { background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; padding: .8rem 1rem; color: var(--ink-0); width: 100%; font-size: .9rem; }
  .newsletter-input:focus { outline: none; border-color: var(--accent); }
  .scroll-top { position: fixed; bottom: 24px; right: 24px; width: 48px; height: 48px; border-radius: 14px; background: linear-gradient(135deg, var(--accent), var(--accent-2)); color: #02121f; border: none; display: none; align-items: center; justify-content: center; font-size: 1.4rem; z-index: 100; box-shadow: 0 10px 30px -8px rgba(34,211,238,0.55); cursor: pointer; font-weight: 900; }
  .scroll-top.show { display: inline-flex; }

  /* ========== PAGE 06 SPECIFIC ========== */
  .module-icon { width: 56px; height: 56px; border-radius: 14px; display: flex; align-items: center; justify-content: center; font-size: 1.6rem; margin-bottom: .5rem; }
  .method-card { padding: 1.8rem; min-height: 270px; display: flex; flex-direction: column; gap: .8rem; }
  .metric-box { padding: 1rem; border-radius: var(--radius-sm); background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); text-align: center; }
  .metric-box .v { font-size: 1.5rem; font-weight: 800; font-family: 'JetBrains Mono', monospace; }
  .metric-box .l { font-size: .72rem; color: var(--ink-3); text-transform: uppercase; letter-spacing: .1em; }

  /* Corridor grid card */
  .corridor-card { padding: 1.4rem; border-radius: var(--radius-md); background: rgba(6,18,46,0.55); border: 1px solid rgba(255,255,255,0.08); min-height: 220px; transition: all .3s; position: relative; overflow: hidden; cursor: pointer; }
  .corridor-card:hover { transform: translateY(-3px); border-color: var(--accent); background: rgba(34,211,238,0.05); }
  .corridor-card .flag-row { display:flex; justify-content:space-between; align-items:center; font-size:1.8rem; margin-bottom:.8rem; }
  .corridor-card .ccy { font-family:'JetBrains Mono',monospace; font-weight:700; font-size:1.1rem; }

  /* Corridor table */
  .corridor-table th, .corridor-table td { padding: .85rem 1rem; border-bottom: 1px solid rgba(255,255,255,0.06); font-size: .88rem; }
  .corridor-table thead th { color: var(--ink-2); text-transform: uppercase; letter-spacing: .1em; font-size: .7rem; font-weight: 600; }

  /* Tracking mockup */
  .tracking-step { padding: .9rem 1rem; border-radius: var(--radius-sm); background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); display:flex; align-items:center; gap:.8rem; margin-bottom:.4rem; position:relative; }
  .tracking-step.done { background: rgba(34,197,94,0.08); border-color: rgba(34,197,94,0.3); }
  .tracking-step.active { background: rgba(34,211,238,0.08); border-color: rgba(34,211,238,0.3); }
  .tracking-step .num { width:32px; height:32px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-weight:700; font-family:'JetBrains Mono',monospace; font-size:.85rem; flex-shrink:0; }
  .tracking-step.done .num { background: var(--success); color: #021818; }
  .tracking-step.active .num { background: var(--accent); color: #02121f; animation: pulseGlow 2s infinite; }
  .tracking-step:not(.done):not(.active) .num { background: rgba(255,255,255,0.05); color: var(--ink-2); }

  .cta-banner { position: relative; overflow: hidden; padding: 5rem 2rem; border-radius: var(--radius-lg); background: radial-gradient(600px 300px at 80% 20%, rgba(167,139,250,0.28), transparent 60%), radial-gradient(500px 300px at 20% 80%, rgba(34,211,238,0.28), transparent 60%), linear-gradient(135deg, #0a1a3f 0%, #06122e 100%); border: 1px solid rgba(34,211,238,0.2); }

  footer { background: #030512; border-top: 1px solid rgba(255,255,255,0.06); padding: 4rem 0 1.5rem; }
  footer h5 { font-size: .85rem; text-transform: uppercase; letter-spacing: .12em; color: var(--ink-0); margin-bottom: 1rem; }
  footer a { color: var(--ink-3); font-size: .88rem; display: block; padding: .3rem 0; }
  footer a:hover { color: var(--accent); }
  .social-icon { width: 36px; height: 36px; border-radius: 10px; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); display: inline-flex; align-items: center; justify-content: center; color: var(--ink-2); font-size: 1rem; transition: all .25s; text-decoration: none; margin-right: .4rem; }
  .social-icon:hover { color: var(--accent); border-color: var(--accent); transform: translateY(-2px); }

  @media (max-width: 992px) { section { padding: 4rem 0; } }
  @media (max-width: 768px) { section { padding: 3rem 0; } }
  ::-webkit-scrollbar { width: 10px; height: 10px; }
  ::-webkit-scrollbar-track { background: #06122e; }
  ::-webkit-scrollbar-thumb { background: linear-gradient(180deg, #22d3ee, #60a5fa); border-radius: 10px; }
</style>
</head>
<body class="bg-gradient-deep">


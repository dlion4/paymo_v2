<!-- ===================== SCRIPTS ===================== -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
<script>
/* REVEAL */
(function(){ const obs = new IntersectionObserver((es)=>{ es.forEach(e=>{ if(e.isIntersecting){ e.target.classList.add('in'); obs.unobserve(e.target); }}); },{threshold:0.08,rootMargin:'0px 0px -60px 0px'}); document.querySelectorAll('.reveal').forEach(el=>obs.observe(el)); })();

/* SCROLL TOP */
(function(){ const btn = document.getElementById('scrollTop'); window.addEventListener('scroll',()=>btn.classList.toggle('show', window.scrollY>700)); })();

/* MOBILE NAV */
function toggleMobileNav(){ document.getElementById('mobileNav').classList.toggle('show'); }

/* CLOCKS */
function tickClock(id){ const el = document.getElementById(id); if(!el) return; const d = new Date(); const pad = n => String(n).padStart(2,'0'); el.textContent = pad(d.getHours())+':'+pad(d.getMinutes())+':'+pad(d.getSeconds()); }
setInterval(()=>{ tickClock('globalClock'); tickClock('swiftClock'); tickClock('trackClock'); }, 1000);
tickClock('globalClock'); tickClock('swiftClock'); tickClock('trackClock');

/* CORRIDOR GRID */
const corridors = [
  { from:'🇬🇧 UK', to:'🇳🇬 Nigeria', rail:'NIBSS', settle:'Same-day', fee:'$1.50 + 0.5%', live:true },
  { from:'🇺🇸 USA', to:'🇰🇪 Kenya', rail:'M-Pesa', settle:'Same-day', fee:'$1.80 + 0.6%', live:true },
  { from:'🇪🇺 EU', to:'🇬🇭 Ghana', rail:'MoMo', settle:'Same-day', fee:'$1.50 + 0.5%', live:true },
  { from:'🇦🇪 UAE', to:'🇿🇦 South Africa', rail:'EFT', settle:'T+1', fee:'$2.00 + 0.7%', live:true },
  { from:'🇨🇦 Canada', to:'🇸🇳 Senegal', rail:'Orange Money', settle:'T+1', fee:'$2.20 + 0.8%', live:true },
  { from:'🇮🇳 India', to:'🇨🇮 Côte d\'Ivoire', rail:'Wave', settle:'T+1', fee:'$2.00 + 0.7%', live:true },
  { from:'🇸🇬 Singapore', to:'🇹🇿 Tanzania', rail:'M-Pesa', settle:'T+1', fee:'$2.00 + 0.7%', live:true },
  { from:'🇳🇬 Nigeria', to:'🇺🇸 USA', rail:'ACH', settle:'T+1', fee:'$2.00 + 0.8%', live:true },
  { from:'🇰🇪 Kenya', to:'🇬🇧 UK', rail:'FPS', settle:'Same-day', fee:'$1.50 + 0.6%', live:true },
  { from:'🇿🇦 South Africa', to:'🇪🇺 EU', rail:'SEPA', settle:'Same-day', fee:'$1.50 + 0.5%', live:true },
  { from:'🇦🇪 UAE', to:'🇳🇬 Nigeria', rail:'NIBSS', settle:'Same-day', fee:'$1.80 + 0.5%', live:true },
  { from:'🇺🇸 USA', to:'🇬🇭 Ghana', rail:'GhIPSS', settle:'Same-day', fee:'$1.80 + 0.6%', live:true },
];
function renderCorridorGrid(){
  const el = document.getElementById('corridorGrid'); if(!el) return;
  el.innerHTML = corridors.map(c=>`
    <div class="col-6 col-md-4 col-lg-3">
      <div class="corridor-card glass-hover">
        <div class="flag-row">
          <span class="ccy">${c.from}</span>
          <i class="bi bi-arrow-right" style="color:var(--accent)"></i>
          <span class="ccy">${c.to}</span>
        </div>
        <div class="d-flex justify-content-between small mb-1"><span style="color:var(--ink-3)">Best rail</span><span class="mono" style="color:var(--accent)">${c.rail}</span></div>
        <div class="d-flex justify-content-between small mb-1"><span style="color:var(--ink-3)">Settlement</span><span class="mono">${c.settle}</span></div>
        <div class="d-flex justify-content-between small mb-2"><span style="color:var(--ink-3)">Typical fee</span><span class="mono fw-bold text-gradient-gold">${c.fee}</span></div>
        <span class="badge-mini ${c.live?'badge-ok':'badge-native'}">${c.live?'● Live':'● New'}</span>
      </div>
    </div>`).join('');
}
renderCorridorGrid();

/* CORRIDOR TABLE */
const corridorTableData = [
  { c:'UK → Nigeria (GBP → NGN)', rail:'NIBSS', settle:'Same-day', fee:'$1.50 + 0.5%', bank:'$8 + 3.5%', save:'61%' },
  { c:'USA → Kenya (USD → KES)', rail:'M-Pesa', settle:'Same-day', fee:'$1.80 + 0.6%', bank:'$10 + 3.2%', save:'63%' },
  { c:'EU → Ghana (EUR → GHS)', rail:'MoMo', settle:'Same-day', fee:'$1.50 + 0.5%', bank:'$8 + 3.3%', save:'62%' },
  { c:'UAE → South Africa (AED → ZAR)', rail:'EFT', settle:'T+1', fee:'$2.00 + 0.7%', bank:'$12 + 3.8%', save:'64%' },
  { c:'Canada → Senegal (CAD → XOF)', rail:'Orange Money', settle:'T+1', fee:'$2.20 + 0.8%', bank:'$15 + 4.0%', save:'67%' },
  { c:'Singapore → Tanzania (SGD → TZS)', rail:'M-Pesa', settle:'T+1', fee:'$2.00 + 0.7%', bank:'$12 + 3.5%', save:'65%' },
  { c:'Nigeria → USA (NGN → USD)', rail:'ACH', settle:'T+1', fee:'$2.00 + 0.8%', bank:'$10 + 3.4%', save:'58%' },
  { c:'Kenya → UK (KES → GBP)', rail:'Faster Payments', settle:'Same-day', fee:'$1.50 + 0.6%', bank:'$8 + 3.3%', save:'60%' },
  { c:'India → Côte d\'Ivoire (INR → XOF)', rail:'Wave', settle:'T+1', fee:'$2.00 + 0.7%', bank:'$12 + 4.2%', save:'69%' },
];
function renderCorridorTable(){
  const el = document.getElementById('corridorTable'); if(!el) return;
  el.innerHTML = corridorTableData.map(c=>`
    <tr>
      <td class="fw-bold">${c.c}</td>
      <td>${c.rail}</td>
      <td>${c.settle}</td>
      <td class="mono text-gradient-gold">${c.fee}</td>
      <td class="mono" style="color:#fca5a5">${c.bank}</td>
      <td><span class="badge-mini badge-ok">Save ${c.save}</span></td>
    </tr>`).join('');
}
renderCorridorTable();

/* MODAL */
const modalContent = {
  sandbox: { title:'Start Building · Free Sandbox', body: `<p class="mb-3" style="color:var(--ink-2)">Global transfers sandbox. API keys in ~2 minutes.</p>
    <form onsubmit="submitForm(event,'sandbox')">
      <div class="row g-3">
        <div class="col-md-6"><label class="small" style="color:var(--ink-3)">Work email *</label><input required type="email" class="newsletter-input" placeholder="you@company.com"/></div>
        <div class="col-md-6"><label class="small" style="color:var(--ink-3)">Company *</label><input required type="text" class="newsletter-input" placeholder="Acme Inc"/></div>
        <div class="col-md-6"><label class="small" style="color:var(--ink-3)">Use case</label><select class="newsletter-input"><option>Remittance App</option><option>Diaspora Neobank</option><option>B2B Payables</option><option>B2C Payouts</option><option>Marketplace</option></select></div>
        <div class="col-md-6"><label class="small" style="color:var(--ink-3)">Primary Corridor</label><select class="newsletter-input"><option>UK/US/EU → Nigeria</option><option>UK/US/EU → Kenya</option><option>UK/US/EU → Ghana</option><option>Dubai → Africa</option><option>Intra-Africa</option></select></div>
      </div>
      <button type="submit" class="btn btn-primary-paymo w-100 mt-3"><i class="bi bi-rocket-takeoff"></i> Generate Sandbox Keys</button>
      <div class="formMsg small mt-2" style="color:var(--success);display:none;">✓ Created. Check your email for API keys.</div>
    </form>` },
  demo: { title:'Book a Remittance Demo', body: `<p class="mb-3" style="color:var(--ink-2)">Talk to a remittance specialist about your corridors and volumes. 30-min walkthrough, plus a tailored savings estimate.</p>
    <form onsubmit="submitForm(event,'demo')">
      <div class="row g-3">
        <div class="col-md-6"><label class="small" style="color:var(--ink-3)">Full name *</label><input required type="text" class="newsletter-input" placeholder="Jane Doe"/></div>
        <div class="col-md-6"><label class="small" style="color:var(--ink-3)">Work email *</label><input required type="email" class="newsletter-input" placeholder="you@company.com"/></div>
        <div class="col-md-6"><label class="small" style="color:var(--ink-3)">Monthly cross-border volume</label><select class="newsletter-input"><option>Under $100K</option><option>$100K – $1M</option><option>$1M – $10M</option><option>$10M – $100M</option><option>$100M+</option></select></div>
        <div class="col-md-6"><label class="small" style="color:var(--ink-3)">Top corridor</label><select class="newsletter-input"><option>UK/US/EU → Nigeria</option><option>UK/US/EU → Kenya</option><option>UK/US/EU → Ghana</option><option>UK/US/EU → Senegal/Côte d'Ivoire</option><option>Intra-Africa</option><option>Dubai → Africa</option></select></div>
      </div>
      <button type="submit" class="btn btn-primary-paymo w-100 mt-3"><i class="bi bi-calendar-check"></i> Book Remittance Demo</button>
      <div class="formMsg small mt-2" style="color:var(--success);display:none;">✓ Received. A specialist will reply within 2 business hours.</div>
    </form>` },
  signin: { title:'Sign In · Paymo Console', body: `<form onsubmit="submitForm(event,'signin')">
      <div class="mb-3"><label class="small" style="color:var(--ink-3)">Email *</label><input required type="email" class="newsletter-input" placeholder="you@company.com"/></div>
      <div class="mb-3"><label class="small" style="color:var(--ink-3)">Password *</label><input required type="password" class="newsletter-input" placeholder="••••••••"/></div>
      <button type="submit" class="btn btn-primary-paymo w-100"><i class="bi bi-box-arrow-in-right"></i> Sign In</button>
      <div class="formMsg small mt-2" style="color:var(--success);display:none;">✓ Sign in successful (demo) · redirecting...</div>
    </form>
    <div class="mt-4 text-center small" style="color:var(--ink-3)">No account? <a href="#" onclick="openModal('sandbox');return false;" style="color:var(--accent)">Create free sandbox</a></div>` },
  legal: { title:'Legal · Privacy · Terms', body: `<div class="accordion accordion-paymo">
      <div class="accordion-item"><h2 class="accordion-header"><button class="accordion-button collapsed" data-bs-toggle="collapse" data-bs-target="#l1">Privacy</button></h2><div id="l1" class="accordion-collapse collapse"><div class="accordion-body">Customer data encrypted at rest (AES-256) and in transit (TLS 1.3). Retention: 7 years per financial regulations. Deletion rights on request, subject to legal holds.</div></div></div>
      <div class="accordion-item"><h2 class="accordion-header"><button class="accordion-button collapsed" data-bs-toggle="collapse" data-bs-target="#l2">Terms of Service</button></h2><div id="l2" class="accordion-collapse collapse"><div class="accordion-body">Use of Paymo is subject to acceptable-use policies, compliance with all applicable law, and per-corridor transfer limits. FX rates are indicative until locked via a quote call.</div></div></div>
    </div>` },
  discord: { title:'Paymo Community · Discord', body: `<p class="mb-3" style="color:var(--ink-2)">Join 12,400+ African fintech builders and treasury operators. Live office hours every Thursday.</p>
    <a href="#" class="btn btn-primary-paymo w-100" onclick="openModal('sandbox');return false;"><i class="bi bi-chat-dots-fill"></i> Join Paymo Community Discord</a>` }
};
let paymoModal = null;
function openModal(key){
  const data = modalContent[key]; if(!data){ openModal('demo'); return; }
  if(!paymoModal) paymoModal = new bootstrap.Modal(document.getElementById('paymoModal'));
  document.getElementById('modalTitle').textContent = data.title;
  document.getElementById('modalBody').innerHTML = data.body;
  paymoModal.show();
}
function submitForm(e, kind){ e.preventDefault(); const msg = e.target.querySelector('.formMsg'); if(msg) msg.style.display = 'block'; setTimeout(()=>{ if(paymoModal) paymoModal.hide(); e.target.reset(); if(msg) msg.style.display = 'none'; }, 2500); }
function subscribeNewsletter(e){ e.preventDefault(); const msg = document.getElementById('newsletterMsg'); msg.style.display = 'block'; setTimeout(()=>{ msg.style.display = 'none'; e.target.reset(); }, 4500); }
</script>
</body>
</html>
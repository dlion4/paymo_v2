<!-- ===================== 6.1 HERO ===================== -->
<section style="padding:10rem 0 4rem" class="position-relative overflow-hidden">
  <div class="grid-overlay position-absolute w-100 h-100" style="top:0;left:0;"></div>
  <div class="blob" style="width:500px;height:500px;background:#22d3ee;top:-100px;right:-100px;"></div>
  <div class="blob" style="width:420px;height:420px;background:#a78bfa;bottom:-120px;left:-80px;animation-delay:-7s;"></div>

  <div class="container position-relative">
    <div class="row g-5 align-items-center">
      <div class="col-lg-6 reveal">
        <div class="eyebrow-row" style="display:flex;flex-wrap:wrap;gap:.5rem;margin-bottom:1rem">
          <span class="pill"><span class="pill-dot"></span> Global Transfers · Remittance</span>
          <span class="pill" style="background:rgba(251,191,36,.1);border-color:rgba(251,191,36,.3);color:#fde68a"><i class="bi bi-lightning-charge-fill"></i> SWIFT Alternative</span>
        </div>
        <h1 class="mb-4" style="font-size:clamp(2.2rem,4.8vw,4.2rem);line-height:1.05">
          From Lagos to London.<br />
          <span class="text-gradient">From Nairobi to New York.</span><br />
          In seconds.
        </h1>
        <p class="lead mb-5" style="color:var(--ink-2);max-width:560px">
          SWIFT-alternative global transfers, diaspora-facing products, B2B global payables, and B2C payouts. Africa ↔ World, built for the way money actually moves in 2026.
        </p>
        <div class="d-flex flex-wrap gap-3 mb-5">
          <a href="#corridors" class="btn btn-primary-paymo"><i class="bi bi-globe-americas"></i> See Global Corridors</a>
          <a href="#demo" class="btn btn-gold" onclick="openModal('demo');return false;"><i class="bi bi-calendar-check"></i> Book Remittance Demo</a>
          <a href="#sandbox" class="btn btn-outline-paymo" onclick="openModal('sandbox');return false;"><i class="bi bi-terminal"></i> Try Sandbox</a>
        </div>
        <div class="row g-3">
          <div class="col-6 col-md-3"><div class="glass p-3 text-center"><div class="mono fw-bold text-gradient">60%</div><div class="small" style="color:var(--ink-3)">Cheaper than SWIFT</div></div></div>
          <div class="col-6 col-md-3"><div class="glass p-3 text-center"><div class="mono fw-bold text-gradient">8x</div><div class="small" style="color:var(--ink-3)">Faster Settlement</div></div></div>
          <div class="col-6 col-md-3"><div class="glass p-3 text-center"><div class="mono fw-bold text-gradient">50+</div><div class="small" style="color:var(--ink-3)">Corridors</div></div></div>
          <div class="col-6 col-md-3"><div class="glass p-3 text-center"><div class="mono fw-bold text-gradient-gold">≤47s</div><div class="small" style="color:var(--ink-3)">Settlement</div></div></div>
        </div>
      </div>

      <!-- Global rail map -->
      <div class="col-lg-6 reveal">
        <div class="glass p-4">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <span class="pill"><span class="pill-dot"></span> Africa ↔ World Network</span>
            <span class="mono small" id="globalClock" style="color:var(--ink-3)">—</span>
          </div>

          <svg viewBox="0 0 480 380" class="w-100" style="max-height:420px">
            <defs>
              <linearGradient id="gGrad" x1="0" x2="1"><stop offset="0%" stop-color="#22d3ee" stop-opacity=".05"/><stop offset="50%" stop-color="#60a5fa" stop-opacity=".7"/><stop offset="100%" stop-color="#a78bfa" stop-opacity=".05"/></linearGradient>
              <marker id="gArrow" viewBox="0 0 10 10" refX="10" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M 0 0 L 10 5 L 0 10 z" fill="#22d3ee"/></marker>
            </defs>

            <!-- Stylized world hub points -->
            <!-- Africa hubs -->
            <circle cx="220" cy="220" r="7" fill="#22d3ee"/><text x="220" y="240" text-anchor="middle" fill="#a5f3fc" font-size="9" font-family="JetBrains Mono">Lagos</text>
            <circle cx="270" cy="230" r="6" fill="#22d3ee"/><text x="270" y="248" text-anchor="middle" fill="#a5f3fc" font-size="9" font-family="JetBrains Mono">Nairobi</text>
            <circle cx="240" cy="260" r="5" fill="#60a5fa"/><text x="240" y="278" text-anchor="middle" fill="#93c5fd" font-size="8" font-family="JetBrains Mono">Accra</text>
            <circle cx="260" cy="295" r="5" fill="#60a5fa"/><text x="260" y="312" text-anchor="middle" fill="#93c5fd" font-size="8" font-family="JetBrains Mono">Joburg</text>
            <circle cx="200" cy="205" r="5" fill="#60a5fa"/><text x="200" y="192" text-anchor="middle" fill="#93c5fd" font-size="8" font-family="JetBrains Mono">Dakar</text>
            <circle cx="285" cy="175" r="5" fill="#60a5fa"/><text x="285" y="162" text-anchor="middle" fill="#93c5fd" font-size="8" font-family="JetBrains Mono">Cairo</text>

            <!-- Global hubs -->
            <circle cx="100" cy="110" r="7" fill="#a78bfa"/><text x="100" y="95" text-anchor="middle" fill="#c4b5fd" font-size="9" font-family="JetBrains Mono">London</text>
            <circle cx="50" cy="150" r="7" fill="#a78bfa"/><text x="50" y="135" text-anchor="middle" fill="#c4b5fd" font-size="9" font-family="JetBrains Mono">NYC</text>
            <circle cx="380" cy="120" r="7" fill="#a78bfa"/><text x="380" y="105" text-anchor="middle" fill="#c4b5fd" font-size="9" font-family="JetBrains Mono">Dubai</text>
            <circle cx="430" cy="230" r="7" fill="#a78bfa"/><text x="430" y="215" text-anchor="middle" fill="#c4b5fd" font-size="9" font-family="JetBrains Mono">Singapore</text>
            <circle cx="410" cy="190" r="5" fill="#a78bfa"/><text x="410" y="178" text-anchor="middle" fill="#c4b5fd" font-size="8" font-family="JetBrains Mono">Mumbai</text>
            <circle cx="440" cy="260" r="5" fill="#a78bfa"/><text x="440" y="278" text-anchor="middle" fill="#c4b5fd" font-size="8" font-family="JetBrains Mono">Sydney</text>

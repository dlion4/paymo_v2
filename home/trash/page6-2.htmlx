          <div class="tracking-step">
            <span class="num">1</span>
            <div><b>Sender initiates · Day 1</b><br/><small style="color:var(--ink-3)">£5,000 GBP sent from UK bank at midday</small></div>
          </div>
          <div class="tracking-step">
            <span class="num">2</span>
            <div><b>Correspondent banking · Day 1-2</b><br/><small style="color:var(--ink-3)">Routes through 2-3 intermediary banks</small></div>
          </div>
          <div class="tracking-step">
            <span class="num">3</span>
            <div><b>FX conversion (hidden fee) · Day 2-3</b><br/><small style="color:var(--ink-3)">3.5% spread applied — you never see the rate</small></div>
          </div>
          <div class="tracking-step">
            <span class="num">4</span>
            <div><b>Final credit · Day 3-5</b><br/><small style="color:var(--ink-3)">Nigerian bank receives, no receipt</small></div>
          </div>

          <h6 class="mb-2 mt-4" style="color:var(--ink-2)">Paymo Path</h6>
          <div class="tracking-step done">
            <span class="num">✓</span>
            <div><b>Instant initiation · Second 1</b><br/><small style="color:var(--ink-3)">Initiate in dashboard or API — published FX rate shown</small></div>
          </div>
          <div class="tracking-step done">
            <span class="num">✓</span>
            <div><b>FX locked · 30s</b><br/><small style="color:var(--ink-3)">Rate frozen at quoted, 0.18% spread — fully transparent</small></div>
          </div>
          <div class="tracking-step active">
            <span class="num">3</span>
            <div><b>Local rail routing · Minute 2</b><br/><small style="color:var(--ink-3)">Routes via NIBSS partner — no correspondents, no middlemen</small></div>
          </div>
          <div class="tracking-step done">
            <span class="num">✓</span>
            <div><b>Settled · Minute 47</b><br/><small style="color:var(--ink-3)">Receipt issued, webhook fired, ledger entry written</small></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

